# Supabase → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://SEU-PROJETO.supabase.co
# Chave pública: "anon" (legada) ou "publishable" (sb_publishable_...)
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Chave secreta: "service_role" (legada) ou "secret" (sb_secret_...). NUNCA exponha no navegador.
SUPABASE_SERVICE_ROLE_KEY=

# Sal usado para gerar o hash do IP no rate limit de pedidos (qualquer texto aleatório longo)
RATE_LIMIT_SALT=troque-por-um-texto-aleatorio

# Endereço público do site, usado no link de acompanhamento enviado pelo WhatsApp ({link}).
# Opcional: na Vercel o domínio de produção é detectado sozinho. Preencha se tiver domínio próprio.
# SITE_URL=https://www.seudominio.com.br
